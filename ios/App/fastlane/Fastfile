require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Compila l'app e la carica su TestFlight con la App Store Connect API Key — nessuna password Apple ID né certificato manuale in CI: la firma è automatica (CODE_SIGN_STYLE = Automatic nel progetto), la chiave API autorizza xcodebuild a generare/rinnovare da sé certificato e profilo distribuzione."
  lane :beta do
    # app_store_connect_api_key con key_content NON scrive da sé un file su
    # disco (lo tiene solo in memoria, per le action che parlano con App
    # Store Connect via rete) — api_key[:filepath] restava vuoto e xcodebuild
    # si ritrovava con -authenticationKeyPath "" (tentativo precedente).
    # xcodebuild invece un file lo pretende davvero: lo si scrive qui a mano,
    # e si passa key_filepath (non key_content) così l'action lo popola.
    key_path = File.join(Dir.tmpdir, "app_store_connect_api_key.p8")
    File.write(key_path, ENV.fetch("APP_STORE_CONNECT_API_KEY"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: key_path
    )

    # Numero di build sempre nuovo e crescente: TestFlight rifiuta due upload
    # con lo stesso numero per la stessa versione, quindi non può essere un
    # valore fisso nel repo — arriva dalla run di GitHub Actions che ha
    # lanciato la lane (vedi il workflow .github/workflows/ios-testflight.yml).
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    )

    # export_options.teamID (sotto) vale solo per l'esportazione dell'IPA a
    # fine build: la fase di ARCHIVIO che viene prima non lo legge, e senza
    # un Development Team scritto nel progetto stesso xcodebuild si ferma
    # con "Signing for App requires a development team" — è quello che è
    # successo al tentativo precedente. Questa action scrive il team id
    # direttamente nel project.pbxproj, dove la fase di archivio lo trova.
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "App.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID")
    )

    # build_app (gym/xcodebuild) non accetta un parametro "api_key" — quello
    # è per le azioni che parlano con App Store Connect via web (deliver,
    # pilot/upload_to_testflight sotto). Qui l'autorizzazione per la firma
    # automatica va data a xcodebuild stesso, con i tre flag -authenticationKey*
    # che puntano al file .p8 scritto su disco da app_store_connect_api_key.
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      },
      xcargs: "-allowProvisioningUpdates " \
        "-authenticationKeyPath \"#{key_path}\" " \
        "-authenticationKeyID \"#{ENV.fetch('APP_STORE_CONNECT_KEY_ID')}\" " \
        "-authenticationKeyIssuerID \"#{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}\""
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
