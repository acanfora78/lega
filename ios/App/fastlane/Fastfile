require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Compila l'app e la carica su TestFlight con la App Store Connect API Key — nessuna password Apple ID in CI. Certificato e profilo di distribuzione sono creati esplicitamente con la chiave API (cert/sigh) prima dell'archivio, invece di lasciarli generare al volo da xcodebuild in firma automatica: su un runner CI mai autenticato prima, quella strada si fermava su \"No Account for Team\"."
  lane :beta do
    # app_store_connect_api_key con key_content NON scrive da sé un file su
    # disco (lo tiene solo in memoria, per le action che parlano con App
    # Store Connect via rete) — api_key[:filepath] restava vuoto e xcodebuild
    # si ritrovava con -authenticationKeyPath "" (tentativo precedente).
    # xcodebuild invece un file lo pretende davvero: lo si scrive qui a mano,
    # e si passa key_filepath (non key_content) così l'action lo popola.
    key_path = File.join(Dir.tmpdir, "app_store_connect_api_key.p8")
    File.write(key_path, ENV.fetch("APP_STORE_CONNECT_API_KEY"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: key_path
    )

    # Diagnostica: verifica le credenziali con una chiamata REST reale
    # all'App Store Connect API, indipendente dal servizio di firma di
    # xcodebuild (quello dietro -authenticationKeyPath/ID/IssuerID, che ha
    # dato "Communication with Apple failed (401)" nei tentativi precedenti
    # nonostante Key ID e file .p8 risultassero corretti). Se questa chiamata
    # riesce, le credenziali sono valide e il problema è specifico del
    # servizio di firma automatica (spesso in ritardo sugli account nuovi);
    # se fallisce anche questa, il problema è nei valori dei secret stessi.
    begin
      require "spaceship"
      token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
        filepath: key_path
      )
      Spaceship::ConnectAPI.token = token
      apps = Spaceship::ConnectAPI::App.all
      UI.success("✅ DIAGNOSTICA: connessione ad App Store Connect riuscita. App visibili: #{apps.map(&:bundle_id).join(', ')}")
    rescue => e
      UI.error("❌ DIAGNOSTICA: connessione ad App Store Connect FALLITA: #{e.class} — #{e.message}")
    end

    # Numero di build sempre nuovo e crescente: TestFlight rifiuta due upload
    # con lo stesso numero per la stessa versione, quindi non può essere un
    # valore fisso nel repo — arriva dalla run di GitHub Actions che ha
    # lanciato la lane (vedi il workflow .github/workflows/ios-testflight.yml).
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    )

    app_identifier = "it.legacalciooverquaranta.legaover40"

    # La firma "Automatic" con -allowProvisioningUpdates ha smesso di dare
    # errori di autenticazione (la diagnostica sopra lo conferma: le
    # credenziali sono valide), ma si è fermata comunque su "No Account for
    # Team" / "No profiles ... were found" anche forzando la configurazione
    # Release — segno che su un runner CI mai usato prima, la risoluzione
    # "al volo" della firma durante l'archivio non riesce a creare un
    # account interno di Xcode, pur con la chiave API corretta. Si aggira
    # creando certificato e profilo esplicitamente PRIMA, con la stessa
    # chiave API (già verificata funzionante), invece di lasciarli generare
    # da xcodebuild durante l'archivio.
    cert(
      development: false,
      api_key: api_key,
      team_id: ENV.fetch("APPLE_TEAM_ID")
    )

    sigh(
      api_key: api_key,
      app_identifier: app_identifier,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      force: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      bundle_identifier: app_identifier,
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          app_identifier => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
