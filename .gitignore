# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# store dati reale della lega (persistenza locale su file, non va committato)
/.data/

# progetto nativo Android: non ancora usato, resta ignorato per intero
/android/

# progetto nativo iOS (Capacitor): il progetto Xcode va committato — è quello
# che la CI (.github/workflows/ios-testflight.yml) compila su un runner
# macOS — ma non i prodotti di build locali né le preferenze utente di Xcode
ios/App/build/
ios/App/DerivedData/
ios/App/Pods/
**/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
ios/App/*.ipa
ios/App/fastlane/report.xml
ios/App/fastlane/Preview.html
ios/App/fastlane/screenshots/
ios/App/fastlane/test_output/

# typescript
*.tsbuildinfo
next-env.d.ts
